// ============================================================================
//  更多角色台词 (MoreCharacterLines) —— 台词文件
// ============================================================================
//
//  结构：  场景ID -> 角色ID -> { 池名: [台词...] }
//  池名就是「什么时候说的话」：
//      "normal"   平时说的（不写池名、直接写数组的话，就等于只有 normal）
//      "low_hp"   血量 ≤ 25% 时说的 —— 火堆里这是「刚打完一场险仗」的劫后余生，
//                 不是战斗中的呐喊：应该是后怕 / 松口气 / 恼火 / 嘴硬
//      "relic_xxx" / "candle_low" / "girya_*"   下面这些条件触发时说的
//
//  ── 全局设置 ─────────────────────────────────────────────────────────────
//  "_defaultChance": 0.1
//      有专属台词的角色，有 10% 概率抽到 DEFAULT 里的通用台词
//      （0 = 永远只说自己的，1 = 永远说通用的）
//
//  ── 条件与概率 ───────────────────────────────────────────────────────────
//  满足条件时优先说条件池里的话。概率有两套：
//
//  1) 状态类条件（血量、蜡烛、壶铃）写在场景的 "_conditionChance" 里：
//         "low_hp": 0.8     = 血量低时有 80% 说 low_hp 里的话
//         "girya_maxed": 1  = 满足就一定说
//  2) 遗物氛围条件（relic_ 开头的那些）用 "_relicFlavor" 统一控制占比：
//         1 个遗物 → 25%      2 个 → 50%
//         3 个 → 75%          4 个及以上 → 80%
//     余下的概率才轮到角色自己的台词（或通用台词）。
//
//  ── 写作方针（重要）─────────────────────────────────────────────────────
//  火堆是「安静」的场景，这句文本是角色的**内心独白**，要短、轻。
//  每个角色的口吻样例（来自游戏内文本）见 DESIGN.md §5.1「角色口吻指南」：
//      铁甲战士  短句、完整、句号收尾，少用省略号（瓦库的傀儡；"这样才对"）
//      静默猎手  对话中从不开口，只有「……」；内心是省略号碎片（狩猎 / 姐妹 / 证明）
//      故障机器人 几乎不说人话：<嘀嘀声>/<随机混乱的词句>/十六进制
//      储君      自傲、爱喊、爱使唤人（"我等着！！"）
//      亡灵契约师 能正常说话：平时克制、简短、礼貌而坚定，提到建筑师就炸（奥斯提/买鞋/复仇）
//
//  ── 场景一览 ─────────────────────────────────────────────────────────────
//  rest_site   火堆（回血 / 锻造）顶部那句提示语              ← 已接
//  ping        多人模式催促                                   ← 已接
//
//  改完这个文件 → 重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/MoreCharacterLines/lines.json）才需要重新运行 build.ps1。
// ============================================================================
{
  "_defaultChance": 0.1,

  // 遗物台词占比：拥有 N 个火堆遗物 → 说遗物台词的概率 = perRelic × N（不超过 max）
  "_relicFlavor": { "perRelic": 0.25, "max": 0.8 },

  // ── 多人催促（ping）的时间设置 ────────────────────────────────────────────
  // 规则：≥50% 的玩家已经结束回合、剩下的人还在继续打时开始计时，
  //       超过 urgentAfterSeconds → 说 wait_urgent 池（更急）
  //       超过 angryAfterSeconds  → 说 wait_angry 池（更凶）
  //       下一回合自动清零。
  // 想验证「更急 / 更凶」的台词不用真等 5 分钟：把这两个数改小（单位：秒），改完即时生效。
  "_ping": {
    "urgentAfterSeconds": 60,
    "angryAfterSeconds": 300
  },

  // ── 火堆 ────────────────────────────────────────────────────────────────
  "rest_site": {
    // 状态类条件的概率（遗物氛围条件不看这里，见上面的 _relicFlavor）
    "_conditionChance": {
      "low_hp": 0.8,
      "candle_low": 0.8,
      "girya_maxed": 1,
      "girya_progress": 0.15
    },

    // 铁甲战士：瓦库的傀儡。说话短而完整、少用省略号
    // （参考低语耳环那句「这样才对」和面对瓦库时的「神圣恶魔！你都对我做了什么！？」）
    "IRONCLAD": {
      "normal": [
        "稍作调整。继续杀戮。",
        "稍息。前进。",
        "敌人还在上面。",
        "火。很好。",
        "（铁甲战士目光空洞地望着火堆。）"
      ],
      "low_hp": [
        "致命伤算什么。",
        "疼痛算不了什么。",
        "还能站着，够了。",
        "（铁甲战士颤抖着撞进休息处。）"
      ]
    },

    // 静默猎手：对话中从不开口（游戏里她作为对话方的台词只有「……」）。
    // 火堆这句算内心想法，可以用省略号碎片，但别给她流利的长句；
    // 主题：狩猎 / 姐妹 / 证明 / 活下去。
    "SILENT": {
      "normal": [
        "……稍作调整……",
        "……",
        "（静默猎手安静地磨着刀）",
        "狩猎……尚未结束……",
        "……还没……证明……"
      ],
      "low_hp": [
        "（静默猎手摇摇晃晃地走进休息处。）",
        "差点……被狩猎了……",
        "……还活着。",
        "……活下去……才能继续狩猎……"
      ]
    },

    // 故障机器人：几乎不说"人话"。它的台词基本只有
    //   <...>  （声音 / 状态的旁白式描述，游戏原文：<安静的嘀嘀声>、<随机混乱的词句>）
    //   十六进制 / 二进制（0x… / 1100 0011 …）
    // 完整句子极少，别给它写流利长句。
    "DEFECT": {
      "normal": [
        "<安静的嘀嘀声>",
        "（故障机器人进入了待机模式。）",
        "<散热片的嗡鸣声>",
        "1100 0011 1100 0011……",
        "0x52 0x45 0x53 0x54.",
        "<3"
      ],
      "low_hp": [
        "<恐惧的嘀嘀声>",
        "<随机混乱的词句>",
        "<高度失真的滴滴声>",
        "（故障机器人错乱地进入了休息处。）",
        "<分析：损伤严重，但可运行。>"
      ]
    },

    // 储君：自认群星之王，自傲爱喊，习惯使唤人
    "REGENT": {
      "normal": [
        "让外面的愚者先候着！",
        "我需要小憩一下……",
        "（殿下安静地坐在火堆旁。）",
        "怪异的生物！都别来打扰我！"
      ],
      "low_hp": [
        "那些生物……竟敢把我打成这样！",
        "区区杂兵，也配伤到我？！",
        "我可是未来的王……怎么可能倒在这种地方！！",
        "（储君一脸愤怒地冲进了休息处。）"
      ]
    },

    // 亡灵契约师：能正常说话，且很有分寸 —— 平时克制、简短、礼貌而坚定
    // （"我的目标很单纯" / "暴力不可避免" / "别多费唇舌了，恶魔"），
    // 一提到建筑师就会炸（"他杀死了我爱的一切！！"）；偶尔露出小孩的一面（买鞋、奥斯提、朋友）。
    "NECROBINDER": {
      "normal": [
        "奥斯提，休息一下吧。",
        "路还长。我不会停下。",
        "等复仇结束……就去买双鞋。",
        "等一切结束……我想再变回人。",
        "（亡灵契约师在休息处仰望着火光。）",
        "（奥斯提安静地休息着。）"
      ],
      "low_hp": [
        "……差点就回不来了。",
        "还不能死……仇还没报呢。",
        "朋友们还在等我。",
        "（亡灵契约师摇摇欲坠地浮进了休息处。）"
      ]
    },

    // 通用池：没写专属台词的角色（含 mod 角色）从这里抽。
    // 下面这些遗物 / 状态台词都只写了 DEFAULT —— 所有角色通用；
    // 想给某个角色单独写，就在它自己那段里加同名池。
    "DEFAULT": {
      "normal": [
        "我该做什么呢……",
        "嗯……",
        "有不少选择啊……",
        "小憩一下……",
        "……接下来要做什么呢……",
        "让我想想……"
      ],
      "low_hp": [
        "总算活下来了……",
        "差点就回不来了……",
        "让我缓一缓……"
      ],

      // 南瓜蜡烛剩 ≤ 2 层
      "candle_low": [
        "（南瓜蜡烛的火苗微弱的闪动着，似乎该给它添火了……）"
      ],

      // 壶铃练满（只播一次）
      "girya_maxed": [
        "（你看着自己的肌肉，很是满意。）"
      ],

      // 壶铃还没练满
      "girya_progress": [
        "是时候举举重了……",
        "锻炼一下似乎也不错……",
        "要强身健体啊……",
        "（壶铃上的脸狰狞地看着你……你莫名有了锻炼的欲望。）"
      ],

      // 铲子：能挖遗物
      "relic_shovel": [
        "（休息处下方似乎传来一些遗物的回响……）",
        "（休息处下面会有什么遗物呢……）",
        "（似乎休息处下面有些什么东西……）",
        "（这把铲子在休息处能挖到什么呢……）"
      ],

      // 切肉刀：能烹饪
      "relic_cleaver": [
        "有些饿了啊……",
        "该煮点东西了……",
        "是啊，吃什么……",
        "事已至此，先吃饭吧。"
      ],

      // 微型帐篷：可以多选
      "relic_tent": [
        "（帐篷为你搭建了一个可靠的庇护所，你可以在此好好休整了。）",
        "不用再顾虑选择了……",
        "睡起来之后再敲牌吧……"
      ],

      // 捕梦网：休息时能加一张牌
      "relic_dream_catcher": [
        "梦里或许有些想不起的记忆……",
        "古老的仪式物品让你有了入梦的欲望……"
      ],

      // 小邮箱：休息时给两瓶药水
      "relic_mailbox": [
        "睡一觉就不会口渴了……",
        "睡一觉或许可以等到送奶工吧……"
      ],

      // 皇家枕头：多回 15 点血
      "relic_pillow": [
        "终于可以睡个好觉了……",
        "（松软的枕头或许让你能够轻松入梦。）"
      ],

      // 佩尔的增生组织：能克隆一张牌
      "relic_paels_growth": [
        "（佩尔的组织在你的手中跳动着……）",
        "（佩尔的增生组织跳动着，似乎想利用休息处的热量分裂。）"
      ],

      // 石炉加湿器：休息时 +5 最大生命
      "relic_humidifier": [
        "（涅奥的加湿器令你的困意袭来……）",
        "（加湿器的烟雾缭绕着，似乎睡一觉会很不错……）"
      ],

      // 古茶具套装：下场战斗 +2 费
      "relic_tea_set": [
        "小憩一下……喝两口茶……",
        "（喝了一口茶，味道甘甜。）",
        "（你看着这副精美的茶具，不禁思索起它的来历。）"
      ],

      // 古茶具套装？？？（假货）：下场战斗 +1 费。有真货时不出现
      "relic_fake_tea_set": [
        "（你看着这古怪的茶具，竟不知如何下口。）",
        "呃……好苦的茶叶……",
        "（你盼望着这套茶具别在你手里散架。）"
      ]
    }
  },

  // ── 多人催促（ping）──────────────────────────────────────────────────────
  // 结束回合后按下 Ping 按钮，角色头顶弹出的那句催促语（气泡 1.5 秒、1 秒限流）。
  //
  // 三个池子对应三档语气（时间设置见文件开头的 _ping）：
  //     normal      —— 刚开始等，或者还没到 50% 人结束回合
  //     wait_urgent —— ≥50% 的人已经结束回合、剩下的人还在打，超过 1 分钟（更急）
  //     wait_angry  —— 同上，超过 5 分钟（更凶）
  //
  // 原版那句（铁甲战士「快点。」等）放在 normal 第一条 —— 这样至少和原版一致，
  // 再叠加「更多变化」。
  //
  // 写法要求（**和火堆不一样，别照抄火堆那套**）：
  //   - 气泡 = 这个角色**说出口的话**，所以**不许写（旁白）**。
  //     火堆那句是内心独白，才用「（）= 旁白」；在气泡里那等于角色在旁白自己，是错的。
  //     动作 / 神态要么用角色自己的话说出来，要么用 BBCode 效果代替。
  //   - 气泡是富文本（MegaRichTextLabel），可以用 BBCode 表现语气：
  //         [wave]…[/wave]     轻轻晃动 —— 「更急」
  //         [shake]…[/shake]   发抖     —— 「更凶」
  //         [jitter]…[/jitter] 抖动（原版故障机器人的十六进制就这么用）
  //         [sine]…[/sine]     波浪（原版静默猎手就这么用）
  //     效果名写错会在气泡里**原样显示**，所以只用已知标签（check_lines.py 会检查）。
  //   - ping 是开口说话（比火堆独白外放），但气泡只显示 1.5 秒，句子要短。
  //   - 两边客户端看到的是同一句（按「回合号 + 催促者 + 档位」确定性抽取），别写只有自己懂的梗。
  //   - 死人不说话：原版死亡状态是「……」，本 mod 不接管。
  "ping": {
    // 两档语气条件：满足就一定会说（想改成"只是有概率说"就调小这里的数字）
    "_conditionChance": { "wait_urgent": 1, "wait_angry": 1 },

    // 铁甲战士：短句、句号收尾、少用省略号；越等越暴躁，最后一句气得发抖
    "IRONCLAD": {
      "normal": [
        "快点。",
        "抓紧时间。",
        "别磨蹭。"
      ],
      "wait_urgent": [
        "还没好吗。",
        "我等太久了。",
        "别让我一直等。"
      ],
      "wait_angry": [
        "[red]还磨蹭什么！[/red]",
        "[red]有完没完！[/red]",
        "[red][shake]我的忍耐有限度。[/shake][/red]"
      ]
    },

    // 静默猎手：她从**不开口**，所以三档都是「……」，情绪只能靠富文本效果表现：
    //   正常 = 什么效果都没有（纯粹的沉默）
    //   更急 = [wave] 晃动      更凶 = [shake] 发抖
    "SILENT": {
      "normal": [
        "……"
      ],
      "wait_urgent": [
        "[wave]……[/wave]"
      ],
      "wait_angry": [
        "[shake]……[/shake]"
      ]
    },

    // 故障机器人：不说人话 —— <嘀嘀声> 是游戏原版给它的"台词"写法（<安静的嘀嘀声>），
    // 十六进制直接甩数据；两者都沿用原版的 [jitter]，最凶那档改成 [shake] 报警。
    // （原版原句 = TIME LIMIT EXCEED；这里补 HASTEN / ERROR）
    "DEFECT": {
      "normal": [
        "[jitter]0x54494D45 0x204C494D 0x49542045 0x58434545 0x00444544[/jitter]",
        "<不耐烦的嘀嘀声>",
        "<随机混乱的词句>"
      ],
      "wait_urgent": [
        "<急迫的嘀嘀声>",
        "[jitter]<随机混乱的词句>[/jitter]",
        "[jitter]0x48415354 0x454E0000[/jitter]"
      ],
      "wait_angry": [
        "<警告的嘀嘀声>",
        "[shake]<随机混乱的词句>[/shake]",
        "[shake]0x4552524F 0x52000000[/shake]"
      ]
    },

    // 储君：爱喊、要面子、把别人当平民使唤；最气的一句用 [shake] 表现"炸毛"
    "REGENT": {
      "normal": [
        "我等着！！",
        "我的耐心是有限的！！",
        "再不结束我可走了！！"
      ],
      "wait_urgent": [
        "我还在等着呢！！",
        "平民！动作快些！！"
      ],
      "wait_angry": [
        "[shake]你们竟敢让未来的王等这么久！！[/shake]",
        "[shake]再不开始，我就要亲自出手了！！[/shake]"
      ]
    },

    // 亡灵契约师：她的催促语基准是**阴阳怪气**，不是礼貌请求 ——
    // 原版那句英文是 "Any day..."（≈「你哪天结束都行」），中文「再等几天也行……」就是它的直译：
    // 表面客气、实际是"你爱怎么打怎么打吧，我无所谓了"。所以省略号和"客气话反着说"都是对的载体。
    //
    //   normal      = 客气话反着说（表面体贴、实际扎人）
    //   wait_urgent = 阴阳里开始漏出不耐烦
    //   wait_angry  = 冷下来放狠话，**不是咆哮** —— 所以刻意不用 BBCode（会晃会抖的是别人，她不会）
    //
    // 提到奥斯提的话也是她说出来的，不是旁白。
    "NECROBINDER": {
      "normal": [
        "再等几天也行……",
        "慢慢来，我不着急……",
        "不急……我又不是等不起……"
      ],
      "wait_urgent": [
        "时间有些紧张啊……",
        "我等得有点久了……"
      ],
      "wait_angry": [
        "我不想再等了。",
        "再拖下去，我就自己走了。",
        "奥斯提已经不耐烦了。"
      ]
    },

    // 通用池：没写专属台词的角色（含 mod 角色）从这里抽
    "DEFAULT": {
      "normal": [
        "……好了吗？",
        "请快点结束。"
      ],
      "wait_urgent": [
        "还没好吗……",
        "快一点吧。"
      ],
      "wait_angry": [
        "[shake]我不等了！[/shake]",
        "[shake]别再拖了！[/shake]"
      ]
    }
  }
}
