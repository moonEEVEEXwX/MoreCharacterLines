// ============================================================================
//  角色台词库 (CharacterLines) —— 台词文件
// ============================================================================
//
//  结构：  场景ID -> 角色ID -> { 池名: [台词...] }
//  池名就是「什么时候说的话」：
//      "normal"   平时说的（不写池名、直接写数组的话，就等于只有 normal）
//      "low_hp"   血量 ≤ 25% 时说的（复用游戏自己的判定 CharacterModel.IsLowHealth，
//                 和低血边框动画是同一个临界点）
//
//  ── 全局设置 ─────────────────────────────────────────────────────────────
//  "_defaultChance": 0.1
//      有专属台词的角色，有 10% 概率抽到 DEFAULT 里的通用台词
//      （0 = 永远只说自己的，1 = 永远说通用的）
//  "_conditionChance": { "low_hp": 0.8 }
//      满足条件时，用条件池的概率。例：血量低时有 80% 说 low_hp 里的话，
//      另外 20% 还是说 normal 里的。想每次都切过去就写 1。
//
//  ── 场景一览 ─────────────────────────────────────────────────────────────
//  rest_site   火堆（回血 / 锻造）顶部那句提示语              ← 已接
//  ping        多人模式催促                                   ← JSON 先占位，代码还没接
//
//  火堆是「安静」的场景，不是战场：台词建议短、轻、内心独白
//  （类似一代休息处的“嗯……”“有不少选择啊……”）。
//
//  改完这个文件 → 重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/CharacterLines/lines.json）才需要重新运行 build.ps1。
// ============================================================================
{
  "_defaultChance": 0.1,
  "_conditionChance": { "low_hp": 0.8 },

  // ── 火堆 ────────────────────────────────────────────────────────────────
  "rest_site": {
    "IRONCLAD": {
      "normal": [
        "稍作调整……继续杀戮……",
        "稍息……前进……",
        "让我缓一缓。",
        "……喘口气。"
      ],
      "low_hp": [
        "……伤得不轻。",
        "血还没止住……",
        "得撑着。"
      ]
    },

    "SILENT": {
      "normal": [
        "……稍作调整……",
        "……",
        "（安静地擦着刀）",
        "风声……很好。"
      ],
      "low_hp": [
        "……不能倒在这里。",
        "伤口……有点深。",
        "……再撑一会儿。"
      ]
    },

    "DEFECT": {
      "normal": [
        "正在……待机。",
        "温度，正在下降……",
        "系统空闲。",
        "散热中……请稍候……"
      ],
      "low_hp": [
        "警告：机体完整性低。",
        "核心受损……还能运转。",
        "……先冷却。"
      ]
    },

    "REGENT": {
      "normal": [
        "让他们先候着。",
        "朕，歇一歇。",
        "……星光很静。",
        "王座……不急。"
      ],
      "low_hp": [
        "……朕还不能倒下。",
        "这具身体……撑得住吗。",
        "……先止血。"
      ]
    },

    "NECROBINDER": {
      "normal": [
        "亡者也需要安静……",
        "……（听着火声）",
        "奥斯提，小声些。",
        "歇一会儿吧。"
      ],
      "low_hp": [
        "……我还不能死。",
        "死亡在靠近……我知道。",
        "……再撑一会儿。"
      ]
    },

    // 通用池：没写专属台词的角色（含 mod 角色）从这里抽
    "DEFAULT": {
      "normal": [
        "我该做什么呢……",
        "嗯……",
        "有不少选择啊……",
        "先歇一会儿……",
        "……接下来呢。",
        "让我想想。"
      ],
      "low_hp": [
        "……先喘口气。",
        "伤得不轻……",
        "得歇一会儿了。"
      ]
    }
  },

  // ── 多人催促（代码还没接，先占位：写在这里暂时不会生效）─────────────────
  // 这个场景只写了数组，等于只有 normal 池
  "ping": {
    "IRONCLAD": [
      "快点。",
      "……在等什么？"
    ],
    "SILENT": [
      "……"
    ],
    "DEFAULT": [
      "……在吗？",
      "我先走了。"
    ]
  }
}
