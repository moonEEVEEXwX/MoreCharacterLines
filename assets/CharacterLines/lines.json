// ============================================================================
//  角色台词库 (CharacterLines) —— 台词文件
// ============================================================================
//
//  结构：  场景ID -> 角色ID -> { 池名: [台词...] }
//  池名就是「什么时候说的话」：
//      "normal"   平时说的（不写池名、直接写数组的话，就等于只有 normal）
//      "low_hp"   血量 ≤ 25% 时说的 —— 火堆里这是「刚打完一场险仗」的劫后余生，
//                 不是战斗中的呐喊：应该是后怕 / 松口气 / 恼火 / 嘴硬
//      "relic_xxx" / "candle_low" / "girya_*"   下面这些条件触发时说的
//
//  ── 全局设置 ─────────────────────────────────────────────────────────────
//  "_defaultChance": 0.1
//      有专属台词的角色，有 10% 概率抽到 DEFAULT 里的通用台词
//      （0 = 永远只说自己的，1 = 永远说通用的）
//
//  ── 条件与概率 ───────────────────────────────────────────────────────────
//  满足条件时优先说条件池里的话。概率有两套：
//
//  1) 状态类条件（血量、蜡烛、壶铃）写在场景的 "_conditionChance" 里：
//         "low_hp": 0.8     = 血量低时有 80% 说 low_hp 里的话
//         "girya_maxed": 1  = 满足就一定说
//  2) 遗物氛围条件（relic_ 开头的那些）用 "_relicFlavor" 统一控制占比：
//         1 个遗物 → 25%      2 个 → 50%
//         3 个 → 75%          4 个及以上 → 80%
//     余下的概率才轮到角色自己的台词（或通用台词）。
//
//  ── 写作方针（重要）─────────────────────────────────────────────────────
//  火堆是「安静」的场景，这句文本是角色的**内心独白**，要短、轻。
//  每个角色的口吻样例（来自游戏内文本）见 DESIGN.md §5.1「角色口吻指南」：
//      铁甲战士  破碎、简短、满脑子敌人与杀戮（瓦库的傀儡）
//      静默猎手  几乎全是省略号；狩猎 / 姐妹 / 证明
//      故障机器人 机器腔、十六进制、尖括号包起来的分析结果；在意朋友
//      储君      自傲、爱喊、爱使唤人（"我等着！！"）
//      亡灵契约师 小女孩，复仇与善意并存，常提到奥斯提
//
//  ── 场景一览 ─────────────────────────────────────────────────────────────
//  rest_site   火堆（回血 / 锻造）顶部那句提示语              ← 已接
//  ping        多人模式催促                                   ← JSON 先占位，代码还没接
//
//  改完这个文件 → 重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/CharacterLines/lines.json）才需要重新运行 build.ps1。
// ============================================================================
{
  "_defaultChance": 0.1,

  // 遗物台词占比：拥有 N 个火堆遗物 → 说遗物台词的概率 = perRelic × N（不超过 max）
  "_relicFlavor": { "perRelic": 0.25, "max": 0.8 },

  // ── 火堆 ────────────────────────────────────────────────────────────────
  "rest_site": {
    // 状态类条件的概率（遗物氛围条件不看这里，见上面的 _relicFlavor）
    "_conditionChance": {
      "low_hp": 0.8,
      "candle_low": 0.8,
      "girya_maxed": 1,
      "girya_progress": 0.15
    },

    // 铁甲战士：与恶魔瓦库契约千年后的傀儡，说话破碎、只剩目标
    "IRONCLAD": {
      "normal": [
        "稍作调整……继续杀戮……",
        "稍息……前进……",
        "敌人……还在上面。",
        "火。很好。"
      ],
      "low_hp": [
        "致命伤……算什么。",
        "痛……算不了什么。",
        "还能站着……就够了。"
      ]
    },

    // 静默猎手：极少开口，几乎全是省略号；狩猎、姐妹、证明
    "SILENT": {
      "normal": [
        "……稍作调整……",
        "……",
        "（安静地磨着刀）",
        "狩猎……尚未结束。"
      ],
      "low_hp": [
        "……（慢慢擦掉刀上的血）",
        "差点……被狩猎了……",
        "……还活着。"
      ]
    },

    // 故障机器人：机器腔 + 十六进制 + 尖括号里的分析；心里在意朋友
    "DEFECT": {
      "normal": [
        "正在……待机。",
        "散热中……请稍候……",
        "<分析：此处安全。>",
        "0x52 0x45 0x53 0x54……"
      ],
      "low_hp": [
        "<分析：损伤严重，但可运行。>",
        "……重新启动完成。",
        "还好……朋友们都没事。"
      ]
    },

    // 储君：自认群星之王，自傲爱喊，习惯使唤人
    "REGENT": {
      "normal": [
        "让他们先候着。",
        "未来的王，也需要歇息。",
        "这点火星……倒还配得上我。",
        "都别来打扰我。"
      ],
      "low_hp": [
        "那些生物……竟敢把我打成这样！",
        "区区杂兵，也配伤到我？！",
        "我可是未来的王……怎么可能死在这种地方！！"
      ]
    },

    // 亡灵契约师：塔里出生的小女孩，复仇者，对朋友很温柔；常提到奥斯提
    "NECROBINDER": {
      "normal": [
        "奥斯提，小声些。",
        "歇一会儿吧。",
        "等复仇结束……就去买双鞋。",
        "朋友们……都还好吗。"
      ],
      "low_hp": [
        "……差点就回不来了。",
        "还不能死……仇还没报呢。",
        "奥斯提……你也没事吧。"
      ]
    },

    // 通用池：没写专属台词的角色（含 mod 角色）从这里抽。
    // 下面这些遗物 / 状态台词都只写了 DEFAULT —— 所有角色通用；
    // 想给某个角色单独写，就在它自己那段里加同名池。
    "DEFAULT": {
      "normal": [
        "我该做什么呢……",
        "嗯……",
        "有不少选择啊……",
        "先歇一会儿……",
        "……接下来呢。",
        "让我想想。"
      ],
      "low_hp": [
        "……总算是活下来了。",
        "差点……就回不来了。",
        "先缓一缓……"
      ],

      // 南瓜蜡烛剩 ≤ 2 层
      "candle_low": [
        "（南瓜蜡烛的火苗微弱的闪动着，似乎该给它添火了……）"
      ],

      // 壶铃练满（只播一次）
      "girya_maxed": [
        "（你看着自己的肌肉，很是满意。）"
      ],

      // 壶铃还没练满
      "girya_progress": [
        "是时候举举重了……",
        "锻炼一下似乎也不错……",
        "要强身健体啊……"
      ],

      // 铲子：能挖遗物
      "relic_shovel": [
        "（火堆的下方似乎传来一些遗物的回响……）",
        "（火堆下面会有什么遗物呢……）"
      ],

      // 切肉刀：能烹饪
      "relic_cleaver": [
        "有些饿了啊……",
        "该煮点东西了……",
        "是啊，吃什么……",
        "事已至此，先吃饭吧。"
      ],

      // 微型帐篷：可以多选
      "relic_tent": [
        "遮风避雨的帐篷……能够在此稍作调整……",
        "不用再顾虑选择了……",
        "睡起来之后再敲牌吧……"
      ],

      // 捕梦网：休息时能加一张牌
      "relic_dream_catcher": [
        "梦里或许有些想不起的记忆……"
      ],

      // 小邮箱：休息时给两瓶药水
      "relic_mailbox": [
        "睡一觉就不会口渴了……",
        "睡一觉或许可以等到送奶工吧……"
      ],

      // 皇家枕头：多回 15 点血
      "relic_pillow": [
        "终于可以睡个好觉了……",
        "（松软的枕头或许让你能够轻松入梦。）"
      ],

      // 佩尔的增生组织：能克隆一张牌
      "relic_paels_growth": [
        "（佩尔的组织在你的手中跳动着……）"
      ],

      // 石炉加湿器：休息时 +5 最大生命
      "relic_humidifier": [
        "（涅奥的加湿器令你能够安睡……）",
        "（加湿器的烟雾缭绕着，似乎睡一觉很不错……）"
      ],

      // 古茶具套装：下场战斗 +2 费
      "relic_tea_set": [
        "小憩一下……喝两口茶……",
        "（喝了一口茶，味道甘甜。）"
      ],

      // 古茶具套装？？？（假货）：下场战斗 +1 费。有真货时不出现
      "relic_fake_tea_set": [
        "（你看着这古怪的茶具，竟不知如何下口。）",
        "（好苦的茶叶……）",
        "（你不知道这个茶具是否会在你手里散架。）"
      ]
    }
  },

  // ── 多人催促（代码还没接，先占位：写在这里暂时不会生效）─────────────────
  // 游戏自带的催促语：铁甲战士「快点。」/ 静默猎手「……」/
  // 故障机器人 一长串十六进制（= TIME LIMIT EXCEED）/ 储君「我等着！！」/
  // 亡灵契约师「再等几天也行……」
  // 这里把它们放第一条，后面是可以补充的、同一口吻的其他说法。
  "ping": {
    "IRONCLAD": [
      "快点。",
      "……在等什么。",
      "别磨蹭。"
    ],
    "SILENT": [
      "……",
      "……（已经在等了）"
    ],
    "DEFECT": [
      "0x54494D45 0x204C494D 0x49542045 0x58434545 0x00444544",
      "……",
      "<分析：等待中。>"
    ],
    "REGENT": [
      "我等着！！",
      "快点，我的耐心是有限的！",
      "再不来我可要走了！！"
    ],
    "NECROBINDER": [
      "再等几天也行……",
      "……不急。",
      "（奥斯提在朝你招手）"
    ],
    "DEFAULT": [
      "……在吗？",
      "我先走了。"
    ]
  }
}
