// ============================================================================
//  角色台词库 (CharacterLines) —— 台词文件
// ============================================================================
//
//  结构：  场景ID -> 角色ID -> { 池名: [台词...] }
//  池名就是「什么时候说的话」：
//      "normal"   平时说的（不写池名、直接写数组的话，就等于只有 normal）
//      "low_hp"   血量 ≤ 25% 时说的
//      "relic_xxx" / "candle_low" / "girya_*"   下面这些条件触发时说的
//
//  ── 全局设置 ─────────────────────────────────────────────────────────────
//  "_defaultChance": 0.1
//      有专属台词的角色，有 10% 概率抽到 DEFAULT 里的通用台词
//      （0 = 永远只说自己的，1 = 永远说通用的）
//
//  ── 条件与概率 ───────────────────────────────────────────────────────────
//  满足条件时优先说条件池里的话。概率有两套：
//
//  1) 状态类条件（血量、蜡烛、壶铃）写在场景的 "_conditionChance" 里：
//         "low_hp": 0.8     = 血量低时有 80% 说 low_hp 里的话
//         "girya_maxed": 1  = 满足就一定说
//  2) 遗物氛围条件（relic_ 开头的那些）用 "_relicFlavor" 统一控制占比：
//         perRelic = 每拥有 1 个火堆遗物，说遗物台词的概率
//         max      = 上限
//     默认 0.25 / 0.8，也就是：
//         1 个遗物 → 25%      2 个 → 50%
//         3 个 → 75%          4 个及以上 → 80%
//     余下的概率才轮到角色自己的台词（或通用台词）。
//     —— 拿的火堆遗物越多，越容易看到遗物相关的台词，不会白拿。
//     想让遗物台词少出现就把 perRelic 调小；写 0 等于关掉（回到只说普通台词）。
//
//  场景里的 "_conditionChance" 优先于文件顶层的同名设置。
//
//  火堆（rest_site）已有的条件：
//      low_hp              血量 ≤ 25%（复用游戏自己的判定 CharacterModel.IsLowHealth）
//      candle_low          南瓜蜡烛剩余层数 ≤ 2 → 该添火了
//      girya_maxed         壶铃已练满 3 层 → 只播一次「看着肌肉很满意」（被别人顶掉会顺延）
//      girya_progress      壶铃还没练满 → 鼓励锻炼
//      relic_shovel        拥有铲子（挖掘）
//      relic_cleaver       拥有切肉刀（烹饪）
//      relic_tent          拥有微型帐篷（可多选）
//      relic_dream_catcher 拥有捕梦网
//      relic_mailbox       拥有小邮箱
//      relic_pillow        拥有皇家枕头
//      relic_paels_growth  拥有佩尔的增生组织（克隆）
//      relic_humidifier    拥有石炉加湿器（休息 +5 最大生命）
//      relic_tea_set       拥有古茶具套装（下场战斗 +2 费）
//      relic_fake_tea_set  拥有古茶具套装？？？（假货，+1 费）
//                          —— 同时有真货时不出现，只说真货那几句
//
//  ── 场景一览 ─────────────────────────────────────────────────────────────
//  rest_site   火堆（回血 / 锻造）顶部那句提示语              ← 已接
//  ping        多人模式催促                                   ← JSON 先占位，代码还没接
//
//  火堆是「安静」的场景，不是战场：台词建议短、轻、内心独白
//  （类似一代休息处的“嗯……”“有不少选择啊……”）。
//
//  改完这个文件 → 重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/CharacterLines/lines.json）才需要重新运行 build.ps1。
// ============================================================================
{
  "_defaultChance": 0.1,

  // 遗物台词占比：拥有 N 个火堆遗物 → 说遗物台词的概率 = perRelic × N（不超过 max）
  "_relicFlavor": { "perRelic": 0.25, "max": 0.8 },

  // ── 火堆 ────────────────────────────────────────────────────────────────
  "rest_site": {
    // 状态类条件的概率（遗物氛围条件不看这里，见上面的 _relicFlavor）
    "_conditionChance": {
      "low_hp": 0.8,
      "candle_low": 0.8,
      "girya_maxed": 1,
      "girya_progress": 0.15
    },

    "IRONCLAD": {
      "normal": [
        "稍作调整……继续杀戮……",
        "稍息……前进……",
        "让我缓一缓。",
        "……喘口气。"
      ],
      "low_hp": [
        "……伤得不轻。",
        "血还没止住……",
        "得撑着。"
      ]
    },

    "SILENT": {
      "normal": [
        "……稍作调整……",
        "……",
        "（安静地擦着刀）",
        "风声……很好。"
      ],
      "low_hp": [
        "……不能倒在这里。",
        "伤口……有点深。",
        "……再撑一会儿。"
      ]
    },

    "DEFECT": {
      "normal": [
        "正在……待机。",
        "温度，正在下降……",
        "系统空闲。",
        "散热中……请稍候……"
      ],
      "low_hp": [
        "警告：机体完整性低。",
        "核心受损……还能运转。",
        "……先冷却。"
      ]
    },

    "REGENT": {
      "normal": [
        "让他们先候着。",
        "朕，歇一歇。",
        "……星光很静。",
        "王座……不急。"
      ],
      "low_hp": [
        "……朕还不能倒下。",
        "这具身体……撑得住吗。",
        "……先止血。"
      ]
    },

    "NECROBINDER": {
      "normal": [
        "亡者也需要安静……",
        "……（听着火声）",
        "奥斯提，小声些。",
        "歇一会儿吧。"
      ],
      "low_hp": [
        "……我还不能死。",
        "死亡在靠近……我知道。",
        "……再撑一会儿。"
      ]
    },

    // 通用池：没写专属台词的角色（含 mod 角色）从这里抽。
    // 下面这些遗物 / 状态台词都只写了 DEFAULT —— 所有角色通用；
    // 想给某个角色单独写，就在它自己那段里加同名池。
    "DEFAULT": {
      "normal": [
        "我该做什么呢……",
        "嗯……",
        "有不少选择啊……",
        "先歇一会儿……",
        "……接下来呢。",
        "让我想想。"
      ],
      "low_hp": [
        "……先喘口气。",
        "伤得不轻……",
        "得歇一会儿了。"
      ],

      // 南瓜蜡烛剩 ≤ 2 层
      "candle_low": [
        "（南瓜蜡烛的火苗微弱的闪动着，似乎该给它添火了……）"
      ],

      // 壶铃练满（只播一次）
      "girya_maxed": [
        "（你看着自己的肌肉，很是满意。）"
      ],

      // 壶铃还没练满
      "girya_progress": [
        "是时候举举重了……",
        "锻炼一下似乎也不错……",
        "要强身健体啊……"
      ],

      // 铲子：能挖遗物
      "relic_shovel": [
        "（火堆的下方似乎传来一些遗物的回响……）",
        "（火堆下面会有什么遗物呢……）"
      ],

      // 切肉刀：能烹饪
      "relic_cleaver": [
        "有些饿了啊……",
        "该煮点东西了……",
        "是啊，吃什么……",
        "事已至此，先吃饭吧。"
      ],

      // 微型帐篷：可以多选
      "relic_tent": [
        "遮风避雨的帐篷……能够在此稍作调整……",
        "不用再顾虑选择了……",
        "睡起来之后再敲牌吧……"
      ],

      // 捕梦网：休息时能加一张牌
      "relic_dream_catcher": [
        "梦里或许有些想不起的记忆……"
      ],

      // 小邮箱：休息时给两瓶药水
      "relic_mailbox": [
        "睡一觉就不会口渴了……",
        "睡一觉或许可以等到送奶工吧……"
      ],

      // 皇家枕头：多回 15 点血
      "relic_pillow": [
        "终于可以睡个好觉了……",
        "（松软的枕头或许让你能够轻松入梦。）"
      ],

      // 佩尔的增生组织：能克隆一张牌
      "relic_paels_growth": [
        "（佩尔的组织在你的手中跳动着……）"
      ],

      // 石炉加湿器：休息时 +5 最大生命
      "relic_humidifier": [
        "（涅奥的加湿器令你能够安睡……）",
        "（加湿器的烟雾缭绕着，似乎睡一觉很不错……）"
      ],

      // 古茶具套装：下场战斗 +2 费
      "relic_tea_set": [
        "小憩一下……喝两口茶……",
        "（喝了一口茶，味道甘甜。）"
      ],

      // 古茶具套装？？？（假货）：下场战斗 +1 费。有真货时不出现
      "relic_fake_tea_set": [
        "（你看着这古怪的茶具，竟不知如何下口。）",
        "（好苦的茶叶……）",
        "（你不知道这个茶具是否会在你手里散架。）"
      ]
    }
  },

  // ── 多人催促（代码还没接，先占位：写在这里暂时不会生效）─────────────────
  // 这个场景只写了数组，等于只有 normal 池
  "ping": {
    "IRONCLAD": [
      "快点。",
      "……在等什么？"
    ],
    "SILENT": [
      "……"
    ],
    "DEFAULT": [
      "……在吗？",
      "我先走了。"
    ]
  }
}
