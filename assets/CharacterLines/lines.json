// ============================================================================
//  角色台词库 (CharacterLines) —— 台词文件
// ============================================================================
//
//  结构：  场景ID -> { "角色ID": [台词...], "DEFAULT": [台词...], "_conditions": {...} }
//  - 没写专属台词的角色（包括 mod 角色）只从该场景的 DEFAULT 里抽
//  - 火堆是回血 / 锻造的「安静」场景，不是战场：台词建议短、轻、内心独白
//    （类似一代休息处的“嗯……”“有不少选择啊……”）
//
//  ── 全局设置 ─────────────────────────────────────────────────────────────
//  "_defaultChance": 0.1
//     有专属台词的角色，抽到 DEFAULT 通用池的概率（0 = 永远只说自己的，1 = 永远说通用）
//
//  ── 条件池（可选）───────────────────────────────────────────────────────
//  场景里可以写 "_conditions"，满足条件时优先从条件池抽；条件池里没写这个角色
//  就自动退回该场景的常规池。已有条件：
//     low_hp   血量 ≤ 25% —— 复用游戏自己的判定（CharacterModel.IsLowHealth），
//              和低血边框动画是同一个临界点
//  条件池里的 "_chance"：满足条件时使用条件池的概率（0~1，默认 1）
//
//  ── 场景一览 ─────────────────────────────────────────────────────────────
//  rest_site   火堆（回血 / 锻造）顶部那句提示语              ← 已接
//  ping        多人模式催促                                   ← JSON 先占位，代码还没接
//
//  改完这个文件 → 重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/CharacterLines/lines.json）才需要重新运行 build.ps1。
// ============================================================================
{
  // 有专属台词的角色，抽到 DEFAULT 通用池的概率
  "_defaultChance": 0.1,

  // ── 火堆 ────────────────────────────────────────────────────────────────
  "rest_site": {
    "IRONCLAD": [
      "稍作调整……继续杀戮……",
      "稍息……前进……",
      "让我缓一缓。",
      "……喘口气。"
    ],
    "SILENT": [
      "……稍作调整……",
      "……",
      "（安静地擦着刀）",
      "风声……很好。"
    ],
    "DEFECT": [
      "正在……待机。",
      "温度，正在下降……",
      "系统空闲。",
      "散热中……请稍候……"
    ],
    "REGENT": [
      "让他们先候着。",
      "朕，歇一歇。",
      "……星光很静。",
      "王座……不急。"
    ],
    "NECROBINDER": [
      "亡者也需要安静……",
      "……（听着火声）",
      "奥斯提，小声些。",
      "歇一会儿吧。"
    ],
    "DEFAULT": [
      "我该做什么呢……",
      "嗯……",
      "有不少选择啊……",
      "先歇一会儿……",
      "……接下来呢。",
      "让我想想。"
    ],

    // 血量 ≤ 25% 时优先说的话（_chance = 0.8：低血时 80% 说这里的，20% 还是说上面的）
    "_conditions": {
      "low_hp": {
        "_chance": 0.8,
        "IRONCLAD": [
          "……伤得不轻。",
          "血还没止住……",
          "得撑着。"
        ],
        "SILENT": [
          "……不能倒在这里。",
          "伤口……有点深。",
          "……再撑一会儿。"
        ],
        "DEFECT": [
          "警告：机体完整性低。",
          "核心受损……还能运转。",
          "……先冷却。"
        ],
        "REGENT": [
          "……朕还不能倒下。",
          "这具身体……撑得住吗。",
          "……先止血。"
        ],
        "NECROBINDER": [
          "……我还不能死。",
          "死亡在靠近……我知道。",
          "……再撑一会儿。"
        ],
        "DEFAULT": [
          "……先喘口气。",
          "伤得不轻……",
          "得歇一会儿了。"
        ]
      }
    }
  },

  // ── 多人催促（代码还没接，先占位：写在这里暂时不会生效）─────────────────
  "ping": {
    "IRONCLAD": [
      "快点。",
      "……在等什么？"
    ],
    "SILENT": [
      "……"
    ],
    "DEFAULT": [
      "……在吗？",
      "我先走了。"
    ]
  }
}
