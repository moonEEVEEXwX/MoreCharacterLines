// ============================================================================
//  火堆台词 (RestSitePrompts) —— 台词文件
// ============================================================================
//
//  火堆是安静的地方（回血 / 锻造），不是战场。
//  所以这里的台词建议短、轻、偏内心独白 —— 像一代休息处那种
//  “嗯……”“有不少选择啊……”的味道，而不是喊打喊杀。
//
//  格式：  "角色ID": [ "台词1", "台词2", ... ]
//  （本文件允许写 // 注释；每条之间用英文逗号，最后一行的逗号可有可无）
//
//  原版五个角色的 ID：
//     IRONCLAD     铁甲战士
//     SILENT       静默猎手
//     DEFECT       故障机器人
//     REGENT       储君
//     NECROBINDER  亡灵契约师
//
//  DEFAULT = 通用台词：
//     - 任何角色（含上面五个）都有机会随机到
//     - 没有写自己专属台词的角色（比如新加的 mod 角色）只会从这里抽
//     - 想改“专属角色抽到通用台词”的概率，改下面的 "_defaultChance"（0~1，默认 0.1）
//
//  想加台词：在对应角色的方括号里新加一行即可，例如
//     "IRONCLAD": [
//       "稍作调整……继续杀戮……",
//       "我新加的一句台词。"
//     ],
//
//  改这个文件后：重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/RestSitePrompts/rest_site_prompts.json）则需要重新运行 build.ps1。
// ============================================================================
{
  // 有专属台词的角色，抽到 DEFAULT 通用池的概率（0 = 永远只说自己的，1 = 永远说通用的）
  "_defaultChance": 0.1,

  "IRONCLAD": [
    "稍作调整……继续杀戮……",
    "稍息……前进……",
    "让我缓一缓。",
    "……喘口气。"
  ],
  "SILENT": [
    "……稍作调整……",
    "……",
    "（安静地擦着刀）",
    "风声……很好。"
  ],
  "DEFECT": [
    "正在……待机。",
    "温度，正在下降……",
    "系统空闲。",
    "散热中……请稍候……"
  ],
  "REGENT": [
    "让他们先候着。",
    "朕，歇一歇。",
    "……星光很静。",
    "王座……不急。"
  ],
  "NECROBINDER": [
    "亡者也需要安静……",
    "……（听着火声）",
    "奥斯提，小声些。",
    "歇一会儿吧。"
  ],
  "DEFAULT": [
    "我该做什么呢……",
    "嗯……",
    "有不少选择啊……",
    "先歇一会儿……",
    "……接下来呢。",
    "让我想想。"
  ]
}
