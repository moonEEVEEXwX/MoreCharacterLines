// ============================================================================
//  火堆台词 (RestSitePrompts) —— 台词文件
// ============================================================================
//
//  格式：  "角色ID": [ "台词1", "台词2", ... ]
//  （本文件允许写 // 注释，写完记得用英文逗号分隔，最后一行的逗号可有可无）
//
//  原版五个角色的 ID：
//     IRONCLAD     铁甲战士
//     SILENT       静默猎手
//     DEFECT       故障机器人
//     REGENT       储君
//     NECROBINDER  亡灵契约师
//
//  DEFAULT = 通用台词：
//     - 任何角色（含上面五个）都有机会随机到
//     - 没有写自己专属台词的角色（比如新加的 mod 角色）只会从这里抽
//     - 想让某个角色永远不说通用台词，就把 25% 这个概率改掉（见 PromptLineStore.cs）
//
//  想加台词：在对应角色的方括号里新加一行即可，例如
//     "IRONCLAD": [
//       "稍作调整……继续杀戮……",
//       "我新加的一句台词。"
//     ],
//
//  改这个文件后：重进一次火堆就生效（不用重新编译，也不用重启游戏）。
//  改 Mod 自带的那份（assets/RestSitePrompts/rest_site_prompts.json）则需要重新运行 build.ps1。
// ============================================================================
{
  "IRONCLAD": [
    "稍作调整……继续杀戮……",
    "稍息……前进……",
    "火堆不灭，杀戮不止。",
    "这点伤，不算什么。"
  ],
  "SILENT": [
    "……稍作调整……",
    "……",
    "（安静地擦拭匕首）",
    "毒还在。人也在。"
  ],
  "DEFECT": [
    "正在……重启核心模块……",
    "系统自检：通过。",
    "散热中……请稍候……",
    "输入指令……未知。那就继续。"
  ],
  "REGENT": [
    "朕需要片刻的安宁……",
    "王座之路……还很长。",
    "让他们再等一等。",
    "星光依旧指引着朕。"
  ],
  "NECROBINDER": [
    "让灵魂……稍微歇一歇……",
    "契约仍在……继续。",
    "亡者的低语……我听着。",
    "……奥斯提，安静点。"
  ],
  "DEFAULT": [
    "我该做什么呢……",
    "接下来……做什么好？",
    "歇一歇，再上路吧。",
    "让我想想……"
  ]
}
